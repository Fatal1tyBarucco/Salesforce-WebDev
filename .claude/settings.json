{
  "permissions": {
    "allow": [
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(uv sync*)",
      "Bash(uv pip*)",
      "Bash(uv run playwright*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(gh*)",
      "Bash(python3*)",
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(README*.md)",
      "Edit(CHANGELOG.md)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(.github/**)",
      "Write(pyproject.toml)",
      "Write(README*.md)",
      "Write(CHANGELOG.md)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Bash(echo *>.env*)",
      "Read(.env*)",
      "Read(*.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-push.py",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== SESSION SUMMARY ===' && git status --short && echo '=== RECENT COMMITS ===' && git log --oneline -5",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}